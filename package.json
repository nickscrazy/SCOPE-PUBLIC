{
  "name": "scope-intelligence",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/server.js && esbuild server/cli.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/cli.js",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check server src tests scripts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "smoke:prod": "tsx scripts/smoke-production.ts",
    "db:migrate": "tsx server/cli.ts migrate",
    "db:seed": "tsx server/cli.ts seed",
    "sync:ted": "NODE_USE_ENV_PROXY=1 tsx server/cli.ts sync-ted",
    "import:grants": "tsx server/cli.ts import-grants",
    "admin:role": "tsx server/cli.ts admin-role",
    "backup": "tsx server/cli.ts backup",
    "backup:verify": "tsx server/cli.ts verify-backup",
    "restore": "tsx server/cli.ts restore",
    "maintenance": "tsx server/cli.ts maintenance",
    "db:migrate:prod": "node dist/cli.js migrate",
    "db:seed:prod": "node dist/cli.js seed",
    "sync:ted:prod": "NODE_USE_ENV_PROXY=1 node dist/cli.js sync-ted"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "10.1.7",
    "postal-mime": "4.0.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.34.0",
    "prettier": "^3.9.10",
    "smtp-server": "3.20.2",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.0",
    "vitest": "4.1.12"
  }
}
