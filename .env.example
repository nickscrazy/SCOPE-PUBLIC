# ---- Runtime ----------------------------------------------------------------
# development | test | staging | production. production enforces HTTPS, SMTP,
# encrypted backups and a declared reverse proxy, and refuses unsafe settings.
APP_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/scope.db
# Reverse proxy hops to trust for client IPs (rate limits). e.g. 1 or loopback.
TRUST_PROXY=
LOG_LEVEL=info

# ---- Email (verification, recovery, notices) --------------------------------
# outbox: writes messages to OUTBOX_DIR for local testing (refused in production)
# smtp:   any SMTP provider, e.g. smtps://USER:PASSWORD@smtp.provider.example:465
EMAIL_PROVIDER=outbox
EMAIL_FROM=SCOPE <no-reply@localhost>
OUTBOX_DIR=./data/outbox
SMTP_URL=

# ---- Billing (disabled until a Stripe account is connected) ------------------
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
SOLO_PRICE_LABEL=€19

# ---- Sources ----------------------------------------------------------------
TED_SYNC_ENABLED=false
TED_SYNC_HOURS_UTC=5,17
TED_MAX_PAGES=5
TED_PAGE_SIZE=100
TED_STALE_HOURS=36
# Optional JSON webhook for ingestion failure/recovery alerts (no personal data is sent).
ALERT_WEBHOOK_URL=
# Enables POST /api/inbound/email with HMAC-signed raw messages (see RUNBOOK.md).
INBOUND_EMAIL_SECRET=

# ---- Editorial --------------------------------------------------------------
EDITORIAL_REVIEW_DAYS=30
EDITORIAL_ALLOW_SELF_APPROVAL=false

# ---- Data lifecycle ---------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# 64 hex characters: openssl rand -hex 32. Store separately from the backups.
BACKUP_ENCRYPTION_KEY=
AUDIT_RETENTION_DAYS=365
UNVERIFIED_ACCOUNT_DAYS=30

# ---- Legal operator (shown on privacy/terms; required before public launch) --
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_REVIEWED=false
